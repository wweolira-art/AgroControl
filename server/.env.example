# Copie para server/.env e configure somente no servidor.
API_PORT=3001
USE_ORACLE=false
ORACLE_USER=SEU_USUARIO
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=oracle.example.com:1521/SERVICO
ORACLE_USE_THICK=false
# Em modo Thick, informe o diretório local do Oracle Instant Client.
ORACLE_INSTANT_CLIENT=
ORDS_CONEXAO_BANCO_URL=https://ords.example.com/ords/app/conexao_banco
ORDS_MAPA_TALHAO_URL=https://ords.example.com/ords/app/mapa_talhao
ORDS_TOKEN=
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=

# Cadastro de usuários protegido por privilégio ORDS, acessível somente pela API.
ORDS_AUTH_USUARIOS_URL=https://ords.example.com/ords/app/usuario
ORDS_AUTH_TOKEN=
# Ative temporariamente apenas para converter hashes SHA256 legados no login.
AUTH_ALLOW_LEGACY_SHA256=false

# Integração EKOS: credenciais somente no servidor/ambiente dos scripts.
JACTO_CONNECT_EMAIL=
JACTO_CONNECT_PASSWORD=

# URL pública HTTPS da API (atualizada pelo utilitário de túnel).
PUBLIC_API_URL=https://api.example.com
