# Configuração pública do aplicativo. Estes valores ficam visíveis no APK/site.
# Nunca coloque senha, chave privada ou token administrativo em EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_USE_MOCK_API=true
EXPO_PUBLIC_ORDS_MAPA_TALHAO_URL=https://ords.example.com/ords/app/mapa_talhao
EXPO_PUBLIC_ORDS_INSUMOS_URL=https://ords.example.com/ords/app/insumos
EXPO_PUBLIC_ORDS_CONEXAO_URL=https://ords.example.com/ords/app/conexao_banco
EXPO_PUBLIC_ORDS_APONTAMENTO_URL=https://ords.example.com/ords/app/apontamento
EXPO_PUBLIC_ORACLE_CONNECT_STRING=oracle.example.com:1521/SERVICO
EXPO_PUBLIC_ORACLE_USER=SEU_USUARIO
